# Copy this file to .env and set real values. Used by Next.js, Prisma, NextAuth, and backend (R2, Redis).
# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/landseed?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Transactional email (Resend)
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
# Use a verified domain in production (not onboarding@resend.dev)
EMAIL_FROM="Landseed <onboarding@resend.dev>"
# Public app URL used in verification and password-reset links
APP_BASE_URL="http://localhost:3000"

# OpenAI (for AI jobs)
OPENAI_API_KEY="sk-..."
OPENAI_ORG_ID="" # LandSeed org ID, for billing attribution (optional)
GRANT_DISCOVERY_AI_MODEL="gpt-4o-mini" # Model for grant discovery web search; defaults to gpt-4o-mini
GRANT_DISCOVERY_DEBUG=true # Verbose [DISCOVERY:*] logs in dev server terminal; set "false" to silence
GRANT_DISCOVERY_DEV_MOCK_GET=false # Set to "false" so GET /api/eligibility/[projectId] returns real DB results in dev

# AI photo analysis / scope inference (advisory — compared against the client's
# declared modification items; mismatches flag for manual review, never override)
PHOTO_ANALYSIS_AI_MODEL="gpt-4o-mini" # Vision-capable model; defaults to gpt-4o-mini
PHOTO_ANALYSIS_DEBUG=true # Verbose [PHOTO_ANALYSIS:*] logs in dev server terminal; set "false" to silence

#SerpAPI (for cost of materials)
SERP_API_KEY=""
SERP_API_COST_PER_QUERY="0" # USD cost per query for cost-tracking logs; "0" while on the free tier, update if you move to a paid plan
PRICING_DEBUG=true # Verbose [PRICING:*] logs in dev server terminal; set "false" to silence

# Cloudflare R2 (photo/document uploads, S3-compatible API)
# Create a bucket and an API token (Account > R2 > Manage API Tokens) in the Cloudflare dashboard.
R2_ACCOUNT_ID=""
R2_BUCKET="your-bucket-name"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Signed URL expiry for grant document downloads (in seconds, clamped between 60 and 86400)
# GRANT_DOCUMENT_DOWNLOAD_URL_EXPIRY_SECONDS="3600" # set by default to 1 hour, can be overridden here

# Redis (queue: virus scanning, AI jobs)
REDIS_URL="redis://localhost:6379"

# FR-4.10: minutes to delay preliminary quote generation after intake submission,
# giving admin/advisory a window to override modification type/scope first.
# Defaults to 15 if unset or invalid; clamped to a maximum of 1440 (24 hours).
# ESTIMATE_GENERATION_DELAY_MINUTES=15

# ClamAV (virus scanning)
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# Feature flags
# FEATURE_FLAG_MANUAL_REVIEW_AUTO_FLAG=true # set to false by default

# Admin MFA: base64-encoded 32-byte AES-256-GCM key for encrypting TOTP secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY="generate-with-node-crypto-randomBytes-32-base64"

# Audit signing (optional)
# To enable cryptographic signing of audit events, provide a PEM-encoded private key
# in `AUDIT_SIGNING_PRIVATE_KEY` (escape newlines or load from a file in production).
# If provided, the system will sign each new audit event. Verification requires the
# corresponding public key in `AUDIT_SIGNING_PUBLIC_KEY`.
AUDIT_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# PEM public key for verification (optional in dev)
AUDIT_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Human-friendly identifier for the signing key (optional)
AUDIT_SIGNING_KEY_ID="local-key"
